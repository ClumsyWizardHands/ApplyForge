# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
# Adzuna free tier (~1,000 calls/month) — developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS (optional, only if federal roles in scope) — developer.usajobs.gov
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
# Optional — commute fallback tier 3 (never required, never a build dependency)
GOOGLE_ROUTES_KEY=
# Polite User-Agent contact address for ATS polling (your own email). Empty:
# identity.email from data/answer_bank.yaml is used, else no address is sent.
JOBKIT_CONTACT_EMAIL=
